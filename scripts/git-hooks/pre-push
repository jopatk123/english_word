#!/bin/sh
# 与 .github/workflows/ci.yml 对齐：推送前先跑 lint 和测试。
# 紧急跳过：SKIP_PRE_PUSH=1 git push，或 git push --no-verify

set -eu

if [ "${SKIP_PRE_PUSH:-}" = "1" ]; then
  echo "SKIP_PRE_PUSH=1，已跳过推送前检查"
  exit 0
fi

has_update=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ -z "${local_sha:-}" ]; then
    continue
  fi
  # 全 0 表示删除远程引用，不需要跑测试
  if [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
    has_update=1
  fi
done

if [ "$has_update" -eq 0 ]; then
  exit 0
fi

root=$(git rev-parse --show-toplevel)
cd "$root"

if [ ! -d node_modules ] || [ ! -d client/node_modules ] || [ ! -d server/node_modules ]; then
  echo "推送前检查需要根目录、client、server 的依赖。请先在仓库根目录执行：" >&2
  echo "  npm install" >&2
  exit 1
fi

echo "推送前执行与 CI 相同的检查：lint + test"
npm run lint:check
npm test
